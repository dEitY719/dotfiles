# pip.conf.internal
# Internal repository configuration for corporate PC
#
# PLACEHOLDER: tracked values are fakes (*.example.invalid). The real ones live
# in the gitignored pip/pip.conf.internal.local, which shell-common/setup.sh
# prefers (seeded by scripts/internal-config-migrate.sh, #1968).
#
# Usage:
#   Symlinked to ~/.config/pip/pip.conf by shell-common/setup.sh
#   Choose this option when using company internal repositories
#
# Note: CA certificate is configured via security.local.sh -> REQUESTS_CA_BUNDLE
#       Proxy is configured via proxy.local.sh -> environment variables

[global]
# Minimal configuration - matches company standard
# Primary internal PyPI repository
index-url = http://registry.example.invalid/repository/proxy-pypi/simple

# Trust the repository host (disable SSL verification if needed)
trusted-host = registry.example.invalid

# ============================================================
# Commented out - managed by other configuration files
# ============================================================
# no-cache-dir = true
# Proxy settings: Use shell-common/env/proxy.local.sh instead
# proxy = http://proxy.example.invalid:8080

# Extra repositories (commented - not used in current setup)
# extra-index-url = http://registry.example.invalid/repository/extra-pypi/simple

# PyTorch wheels (commented - install via dedicated channel if needed)
# find-links = http://registry.example.invalid/repository/proxy-pypi/torch_stable.html

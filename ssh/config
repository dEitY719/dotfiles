# ==========================================
# 0. Machine-local hosts (gitignored, #2006)
# ==========================================
# Internal / per-PC Host blocks (corporate GHES, Gerrit, project servers)
# live in ~/.ssh/config.internal.local, never in this public file. Seed it on
# an internal PC with scripts/internal-ssh-git-migrate.sh --apply (./setup.sh
# runs it in internal mode). Included first so its entries win (first match
# wins); a missing file is ignored, so public PCs are unaffected.
Include ~/.ssh/config.internal.local

# ==========================================
# 1. Public GitHub (HTTPS over SSH)
# ==========================================
Host github.com
    Hostname ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ConnectTimeout 5

# ==========================================
# 2. Global Settings (최하단 배치 - first match wins)
# ==========================================
Host *
    PubkeyAcceptedKeyTypes +ssh-rsa
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ConnectTimeout 10

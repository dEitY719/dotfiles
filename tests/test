#!/bin/bash
#
# Test Suite Runner for Dotfiles Project
#
# Usage:
#   ./tests/test              # Run all tests (parallel by default)
#   ./tests/test -a|--all     # Run all tests (same as above)
#   ./tests/test -v|--verbose # Run with verbose output
#   ./tests/test -s|--serial  # Run tests sequentially (disable parallel)
#   ./tests/test -h|--help    # Show help
#
# Requirements:
#   - Python 3.10+
#   - pytest
#   - pytest-xdist (for parallel execution)
#   - pexpect
#
# Environment:
#   Sets DOTFILES_TEST_MODE=1 for test-aware tool behavior
#   Parallel execution uses all available CPU cores by default
#   Self-throttles: detects other concurrent ./tests/test runs on this host
#   and divides the job count among them
#   Caps every bats test at BATS_TEST_TIMEOUT seconds (default 300) so a hung
#   test fails the suite instead of stalling it forever
#

# Note: Do NOT use 'set -e' as it terminates the script when main() returns
# non-zero exit code. Instead, we handle errors explicitly in main() function.

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Helper functions
print_header() {
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}! $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

# Show help
show_help() {
    cat <<EOF
Test Suite Runner for Dotfiles Project

USAGE:
    ./tests/test [OPTIONS]

OPTIONS:
    -a, --all       Run all tests (default)
    -v, --verbose   Run with verbose output
    -s, --serial    Run tests sequentially (disable parallel execution)
    -h, --help      Show this help message

ENVIRONMENT VARIABLES:
    DOTFILES_TEST_MODE=1  Enable test mode (prevents side effects)
    SKIP_BATS=1           Explicit opt-out: allow the suite to pass even
                           when shell unit tests couldn't run (bats-core
                           missing, or zero .bats files found). Without
                           this, both conditions now fail the suite.
    BATS_TEST_TIMEOUT=N   Per-test timeout in seconds (default: 300). A test
                           exceeding it is killed and reported as
                           "# timeout after Ns" instead of hanging the run.
    BATS_FILE_TIMEOUT=N   Per-file wall clock cap in seconds (default: 900).
                           A bats file still running after it is killed and
                           reported as "FAILED (file timeout ...)".

EXAMPLES:
    ./tests/test                  # Run all tests (parallel)
    ./tests/test --verbose        # Verbose output (parallel)
    ./tests/test --serial         # Sequential execution
    ./tests/test --verbose --serial # Verbose + sequential

PERFORMANCE:
    Default: bats (one process per file) and pytest (xdist) run at the same
             time, each sized to this PC; slowest bats files start first
             (durations cached in ~/.cache/dotfiles/bats-durations.tsv)
    Serial:  Sequential execution, single bats process (~15+ min)
    Jobs:    min(nproc x factor, MemAvailable / TEST_WORKER_MB, TEST_JOBS_MAX)
             divided among concurrent ./tests/test runs on this host. The
             "Parallel:" line prints the figures behind the number.
    Tune:    BATS_JOBS=N / PYTEST_XDIST_AUTO_NUM_WORKERS=N  exact counts
                                               (never throttled)
             TEST_JOBS_FACTOR=F    bats factor   (default: ${_BATS_JOBS_FACTOR})
             PYTEST_JOBS_FACTOR=F  pytest factor (default: ${_PYTEST_JOBS_FACTOR})
             TEST_WORKER_MB=N      memory per job (default: ${_TEST_WORKER_MB_DEFAULT})
             TEST_JOBS_MAX=N       hard cap on either phase
             TEST_RUN_STALE_SEC=N  ignore peer runs older than this (7200)
             TEST_PHASES_SEQUENTIAL=1  run pytest after bats, not alongside
    Ctrl+C:  stops every worker (bats, xargs, pytest) and exits 130

REQUIREMENTS:
    - Python 3.10+
    - pytest
    - pytest-xdist (for parallel execution)
    - pexpect

For more information, see: docs/abc-review-CX.md, docs/test-results-P0.md, and tests/README.md

EOF
}

# Check requirements
check_requirements() {
    local missing=0

    # Check Python
    if ! command -v python3 >/dev/null 2>&1; then
        print_error "Python 3 not found"
        missing=1
    else
        local py_version=$(python3 --version 2>&1 | awk '{print $2}')
        print_info "Python $py_version"
    fi

    # Check pytest
    if ! python3 -m pytest --version >/dev/null 2>&1; then
        print_error "pytest not found. Install with: pip install pytest pexpect"
        missing=1
    else
        local pytest_version=$(python3 -m pytest --version 2>&1 | head -1)
        print_info "$pytest_version"
    fi

    # Check pytest-xdist (optional, for parallel execution)
    # Use import check instead of pip show — uv-managed venvs may not have pip
    HAS_XDIST=0
    local xdist_version
    xdist_version=$(python3 -c "import xdist; print(xdist.__version__)" 2>/dev/null)
    if [ $? -eq 0 ]; then
        print_info "pytest-xdist $xdist_version (parallel execution enabled)"
        HAS_XDIST=1
    else
        print_warning "pytest-xdist not found. Tests will run serially. Install with: uv sync --group dev"
    fi

    if [ $missing -eq 1 ]; then
        print_error "Missing required dependencies"
        return 1
    fi

    return 0
}


# ---------------------------------------------------------------------------
# Concurrency self-throttling (issue #1413)
#
# Every ./tests/test invocation used to claim all $(nproc) cores for itself
# (bats via `xargs -P`, pytest via xdist's `-n auto`). On a machine running
# several worktrees at once that oversubscribes the host — 3-4 concurrent
# runs pushed load average past 25 on 20 cores, and each run got a fraction
# of a core instead of a whole one. So each run now registers itself, counts
# the other live runs, and divides the job pool among them.
# ---------------------------------------------------------------------------

# Registry dir for tracking concurrently-running ./tests/test invocations.
# One empty file per live PID; liveness is re-checked at read time (kill -0)
# and stale entries are pruned as they're found (see
# _concurrent_test_run_count), so a file left by a crashed/killed run is
# harmless. Scoped per-UID: a fixed shared name under TMPDIR would let the
# first user's `mkdir -p` (typically mode 755 under a standard umask) block
# every other user on the same host from registering — each UID gets its own
# directory instead, so cross-user permission conflicts can't happen (agy
# review, PR #1416).
_test_run_registry_dir() {
    printf '%s\n' "${TMPDIR:-/tmp}/dotfiles-tests-test-registry-$(id -u)"
}

# Register this process ($$) in the registry. Best-effort: if the dir can't
# be created (e.g. read-only /tmp), silently no-op — throttling degrades to
# "no throttling", never to a hard failure. The entry holds
# "<kernel start time> <epoch>" (#2054) so a reader can tell a reused PID and
# an hours-old orphan from a genuine peer. "-" = start time unknown (no
# /proc); an empty file (pre-#2054 runner) skips both checks.
_register_test_run() {
    local dir st
    dir="$(_test_run_registry_dir)"
    mkdir -p "$dir" 2>/dev/null || return 0
    st="$(_proc_start_time "$$")"
    printf '%s %s\n' "${st:--}" "$(date +%s)" >"$dir/$$" 2>/dev/null
    return 0
}

# Kernel start time of PID $1 (/proc/<pid>/stat field 22, clock ticks since
# boot) — fixed for a process's lifetime, so a mismatch proves PID reuse.
# Prints nothing where /proc is absent (macOS). comm (field 2) may contain
# spaces or ')', so fields are counted from after its last ')'.
_proc_start_time() {
    local stat
    stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 0
    stat="${stat##*) }"
    # shellcheck disable=SC2086 # deliberate field split
    set -- $stat
    printf '%s\n' "${20:-}"
}

# True when PID $1 was re-parented to init: PPID 1, or WSL's per-session
# "/init" subreaper (observed PPID 373). Such a run lost the `uv run` /
# terminal that started it and is nobody's work anymore (#2054).
_is_orphan_pid() {
    local ppid
    ppid="$(ps -o ppid= -p "$1" 2>/dev/null | tr -d ' ')"
    [ -n "$ppid" ] || return 1
    [ "$ppid" = "1" ] && return 0
    [ "$(ps -o comm= -p "$ppid" 2>/dev/null)" = "init" ]
}

# Count OTHER currently-running ./tests/test invocations (excludes $$).
# A registry entry counts only if `kill -0 <pid>` succeeds; an entry that
# fails the check is actively removed (not just skipped) so the registry
# stays close to its true size instead of growing unbounded across repeated
# runs — this also shrinks the (nonzero but very unlikely) window for a
# stale entry's PID to later be reused by an unrelated live process and get
# miscounted as a peer (codex/agy review, PR #1416).
#
# #2054 hardening: an orphaned run (its `uv run` parent killed) lived for 2+
# hours and halved every later run's jobs. So a live PID is also dropped when
# its recorded start time no longer matches (PID reused — entry removed), and
# skipped when the entry is older than TEST_RUN_STALE_SEC (default 7200) or
# the run has been re-parented to init (_is_orphan_pid).
_concurrent_test_run_count() {
    local dir count=0 f pid st epoch cur stale now
    dir="$(_test_run_registry_dir)"
    [ -d "$dir" ] || {
        printf '0\n'
        return 0
    }
    stale="$(_resolve_positive_int "${TEST_RUN_STALE_SEC:-}" 7200)"
    now="$(date +%s)"
    for f in "$dir"/*; do
        [ -e "$f" ] || continue
        pid="${f##*/}"
        [ "$pid" = "$$" ] && continue
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$f" 2>/dev/null
            continue
        fi
        st="" epoch=""
        read -r st epoch <"$f" 2>/dev/null
        if [ -n "$st" ] && [ "$st" != "-" ]; then
            cur="$(_proc_start_time "$pid")"
            if [ -n "$cur" ] && [ "$cur" != "$st" ]; then
                rm -f "$f" 2>/dev/null
                continue
            fi
        fi
        case "$epoch" in
        '' | *[!0-9]*) ;;
        *) [ $((now - epoch)) -gt "$stale" ] && continue ;;
        esac
        _is_orphan_pid "$pid" && continue
        count=$((count + 1))
    done
    printf '%s\n' "$count"
}

# Budget defaults (#2054), from a one-run-each sweep (x1/x1.5/x2/x3) on a
# 20-CPU and an 8-CPU (taskset) PC, wall seconds per phase alone:
#   bats   20 cpu: 192 / 177 / 181 / 219     8 cpu: 238 / 218 / 228 / 243
#   pytest 20 cpu: 191 / 167 / 150 / 140     8 cpu: 366 / 299 / 254 / 212
# bats bottoms out at x1.5 on both (its tail is one long file, extra jobs
# only add contention); pytest's subprocess-heavy tests keep gaining to x3.
# Peak RSS per job at x3 was 66 MB (bats) and 84-95 MB (pytest), so 100 MB
# per job keeps the memory cap honest without binding on a normal PC.
_BATS_JOBS_FACTOR=1.5
_PYTEST_JOBS_FACTOR=3
_TEST_WORKER_MB_DEFAULT=100

# CPU count: nproc (Linux) → getconf (macOS/BSD) → 4. Shared by the bats and
# pytest throttling paths so the fallback chain lives in exactly one place.
_test_cpu_count() {
    nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4
}

# MemAvailable in MiB, or nothing where /proc/meminfo is absent (macOS) —
# the caller then skips the memory cap.
_test_mem_available_mb() {
    awk '/^MemAvailable:/ { print int($2 / 1024); exit }' /proc/meminfo 2>/dev/null
}

# PC-sized job count (#2054), shared by the bats and pytest phases:
#   max(1, min(cpu * factor, MemAvailable / TEST_WORKER_MB, TEST_JOBS_MAX))
#   divided among this run and its peers (_effective_parallel_jobs).
# $1 = the phase's default factor, $2 = peer count, $3 = factor override
# (default $TEST_JOBS_FACTOR). A factor is N or N.D; anything else falls back
# to $1. Prints "<jobs> (<reason>)" — the reason is the one-line answer to
# "why this many jobs" that the Parallel: banner shows.
_test_job_budget() {
    local factor="${3-${TEST_JOBS_FACTOR:-}}" peers="${2:-0}" cpu mem worker max
    local whole tenth jobs mem_note="n/a" max_note=""
    case "$factor" in
    [0-9] | [0-9][0-9] | [0-9].[0-9] | [0-9][0-9].[0-9]) ;;
    *) factor="$1" ;;
    esac
    whole="${factor%.*}"
    tenth=0
    case "$factor" in *.*) tenth="${factor#*.}" ;; esac
    cpu="$(_test_cpu_count)"
    jobs=$((cpu * (10#$whole * 10 + 10#$tenth) / 10))
    mem="$(_test_mem_available_mb)"
    case "$mem" in
    '' | *[!0-9]*) ;;
    *)
        worker="$(_resolve_positive_int "${TEST_WORKER_MB:-}" "$_TEST_WORKER_MB_DEFAULT")"
        mem_note=$((mem / worker))
        [ "$mem_note" -lt "$jobs" ] && jobs="$mem_note"
        ;;
    esac
    if [ -n "${TEST_JOBS_MAX:-}" ]; then
        max="$(_resolve_positive_int "$TEST_JOBS_MAX" "$jobs")"
        max_note=", max $max"
        [ "$max" -lt "$jobs" ] && jobs="$max"
    fi
    [ "$jobs" -lt 1 ] && jobs=1
    printf '%s (%s cpu x%s, mem cap %s%s, %s peers)\n' \
        "$(_effective_parallel_jobs "$jobs" "$peers")" "$cpu" "$factor" "$mem_note" "$max_note" "$peers"
}

# Divide a base job count among this run and its detected peers.
# effective = max(1, base / (concurrent_count + 1)). Never returns < 1 or
# a non-integer. Falls back to $base unchanged if $base isn't a positive
# integer (defensive — callers already validate, but this must not crash).
#
# $2 (optional) is a precomputed peer count from _concurrent_test_run_count;
# pass it when the caller already has one to avoid re-scanning the registry.
# Omit it (the common case, and what the bats tests exercise) to compute it
# here.
_effective_parallel_jobs() {
    local base="$1" count="${2:-}" effective
    case "$base" in
    '' | *[!0-9]*)
        printf '%s\n' "$base"
        return 0
        ;;
    esac
    [ -n "$count" ] || count=$(_concurrent_test_run_count)
    effective=$((base / (count + 1)))
    [ "$effective" -lt 1 ] && effective=1
    printf '%s\n' "$effective"
}

# Resolve run_bats()'s parallel job count.
#   BATS_JOBS set    → honored verbatim (never throttled), 4 if not a
#                      positive integer (guards a bogus override).
#   BATS_JOBS unset  → _test_job_budget with the bats factor, divided among
#                      this run and any concurrent ./tests/test runs.
#
# $1 (optional) is a precomputed peer count. Omit it to compute internally.
_resolve_bats_jobs() {
    local others="${1:-}" jobs
    if [ -n "${BATS_JOBS:-}" ]; then
        jobs="$BATS_JOBS"
        # Guard a non-positive-integer BATS_JOBS override (gemini review).
        case "$jobs" in
        '' | *[!0-9]*) jobs=4 ;;
        esac
        [ "$jobs" -lt 1 ] && jobs=1
        printf '%s\n' "$jobs"
        return 0
    fi
    [ -n "$others" ] || others="$(_concurrent_test_run_count)"
    jobs="$(_test_job_budget "$_BATS_JOBS_FACTOR" "$others")"
    printf '%s\n' "${jobs%% *}"
}

# Resolve run_bats()'s per-test timeout (issue #1483): unset → 300, a file's
# own setup_file() can raise it further per-file. A non-positive-integer
# override (e.g. "0", "-1", "5m") is fatal to bats-core's own
# bats_start_timeout_countdown(), whose `local -ri timeout=$1` errors on an
# invalid arithmetic value and silently disables the countdown (codex review,
# PR #1492) — exactly the #1483 failure mode this guard exists to prevent. So
# it's rejected the same way _resolve_bats_jobs() guards BATS_JOBS above.
# The full suite is ~4-5 min, so a single test still running after 300s is
# pathological — better a bounded TAP failure than a multi-hour silent hang.
#
# A digit-only string is not automatically safe, though: bash arithmetic
# treats a leading-zero numeral as octal, so "08" — accepted by the
# [!0-9] filter above — still errors bats-core's `local -ri` (or silently
# reinterprets "010" as 8, not 10) unless forced to base 10 here first
# (agy + codex review, PR #1544). A 10+ digit string is rejected outright:
# nobody sets a sane timeout that large, and forcing base 10 on one risks
# overflowing bash's own 64-bit arithmetic before it ever reaches bats-core.
_resolve_bats_timeout() {
    _resolve_positive_int "${BATS_TEST_TIMEOUT:-}" 300
}

# Shared sanitizer behind every seconds/count knob: $1 if it is a positive
# base-10 integer of at most 9 digits, else $2 (see the octal/overflow notes
# above for why each guard exists).
_resolve_positive_int() {
    local value="$1"
    case "$value" in
    '' | *[!0-9]* | ??????????*) value="$2" ;;
    esac
    value=$((10#$value))
    [ "$value" -lt 1 ] && value="$2"
    printf '%s\n' "$value"
}

# Resolve the per-FILE wall clock cap (#2054): unset → 900s. BATS_TEST_TIMEOUT
# bounds a single test but not a bats process that never exits after its last
# test — a daemon spawned by a test (fcitx-autostart) kept bats' pipe open and
# gh_flow.bats sat for 30+ min with all 53 tests passed. 900s is ~3x the
# slowest file seen on an 8-CPU PC, so only a genuine hang ever reaches it.
_resolve_bats_file_timeout() {
    _resolve_positive_int "${BATS_FILE_TIMEOUT:-}" 900
}

# One xargs worker: run bats on one file, its output to <out>/<idx>.log and
# its verdict to <out>/<idx>.status (0 pass, 1 fail, 124 file timeout).
# Exported (export -f) so `xargs ... bash -c` can call it. `timeout
# --foreground` keeps bats in the runner's process group — plain `timeout`
# moves itself into a new one, which the interrupt cleanup could not reach.
_bats_run_file() {
    local bats="$1" out="$2" idx="$3" f="$4" limit rc start=$SECONDS
    limit="$(_resolve_bats_file_timeout)"
    if command -v timeout >/dev/null 2>&1; then
        timeout --foreground -k 10 "$limit" "$bats" "$f" >"$out/$idx.log" 2>&1
    else
        "$bats" "$f" >"$out/$idx.log" 2>&1
    fi
    rc=$?
    case "$rc" in
    0) ;;
    124 | 137)
        rc=124
        printf '# bats file killed after BATS_FILE_TIMEOUT=%ss (the bats process never exited)\n' \
            "$limit" >>"$out/$idx.log"
        ;;
    *) rc=1 ;;
    esac
    # Wall seconds for the longest-first cache; written before .status so
    # the progress ticker never counts a file whose timing is missing.
    printf '%s' "$((SECONDS - start))" >"$out/$idx.secs"
    printf '%s' "$rc" >"$out/$idx.status"
}

# Discover the .bats files run_bats() executes, ordered by @test count
# descending — the cold-cache fallback for _order_bats_by_duration, which
# reorders by measured wall time once a run has recorded it (#2054).
#
# lib/ is the vendored bats-core submodule (its own test suite). _fixtures/ is
# deliberately-broken input invoked directly by tests — notably
# bats/_fixtures/hang_timeout.bats, which hangs on purpose and would burn a
# full BATS_TEST_TIMEOUT on every real run if discovered here.
_discover_bats_files() {
    find "${SCRIPT_DIR}/bats" -type f -name '*.bats' \
        -not -path '*/lib/*' -not -path '*/_fixtures/*' \
        -exec sh -c 'printf "%s\t%s\n" "$(grep -c "^@test" "$1")" "$1"' _ {} \; \
        | sort -rn | cut -f2-
}

# Longest-first scheduling from measured durations (#2054). @test count is
# a poor proxy for runtime: on an 8-CPU PC only 22 of 194 files had finished
# after 2 minutes, and the run still ended on a long tail. Each parallel run
# records every file's wall seconds here; the next run starts the slowest
# first, so the tail is made of the shortest files.
_bats_durations_file() {
    printf '%s\n' "${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/bats-durations.tsv"
}

# Reorder stdin's file paths (discovery order) by recorded duration,
# slowest first. Files with no record go ahead of all — a new file's cost is
# unknown, and starting it early is the safe guess. Keys are paths relative
# to $SCRIPT_DIR so every worktree shares one cache. Rows that are not
# "<digits>\t<path>" are ignored, so a missing or corrupt cache degrades to
# the discovery order (the sort is stable on the input line number).
_order_bats_by_duration() {
    awk -v root="${SCRIPT_DIR}/" -v cache="$(_bats_durations_file)" '
        BEGIN {
            while ((getline row < cache) > 0)
                if (row ~ /^[0-9]+\t[^\t]+$/) {
                    split(row, f, "\t")
                    secs[f[2]] = f[1]
                }
        }
        {
            rel = (index($0, root) == 1) ? substr($0, length(root) + 1) : $0
            printf "%d\t%d\t%s\n", ((rel in secs) ? secs[rel] : 999999999), NR, $0
        }' | sort -t "$(printf '\t')" -k1,1nr -k2,2n | cut -f3-
}

# Write this run's per-file seconds (<outdir>/<idx>.secs, by the same index
# as the file list "$@") to the durations cache, atomically via rename so a
# concurrent run never reads half a file. Best-effort: never fails the run.
_save_bats_durations() {
    local outdir="$1" cache i=0 f secs
    shift
    cache="$(_bats_durations_file)"
    mkdir -p "${cache%/*}" 2>/dev/null || return 0
    for f in "$@"; do
        secs=""
        read -r secs <"$outdir/$i.secs" 2>/dev/null
        case "$secs" in
        '' | *[!0-9]*) ;;
        *) printf '%s\t%s\n' "$secs" "${f#"${SCRIPT_DIR}/"}" ;;
        esac
        i=$((i + 1))
    done >"$cache.$$" 2>/dev/null && mv -f "$cache.$$" "$cache" 2>/dev/null
    rm -f "$cache.$$" 2>/dev/null
    return 0
}

# Build run_bats()'s failure summary line. The ", N timed out" clause appears
# only when a test was actually killed by BATS_TEST_TIMEOUT, so a #1483-style
# hang is visibly distinct from an ordinary assertion failure (#1483 D-1).
_bats_failure_summary() {
    local failed_files="$1" total_files="$2" total_tests="$3" timeout_tests="$4"
    local suffix=""
    [ "$timeout_tests" -gt 0 ] 2>/dev/null && suffix=", ${timeout_tests} timed out"
    printf 'bats: %s of %s files failed (%s tests total%s)\n' \
        "$failed_files" "$total_files" "$total_tests" "$suffix"
}

# Count the tests bats killed via BATS_TEST_TIMEOUT in one run's log ($1).
# bats marks such a kill as `not ok N <name> # timeout after Ns`. Anchored to
# a `not ok` TAP line so a test's own output merely containing this text (a
# fixture name, an echoed assertion message) isn't miscounted as a real
# timeout (agy review, PR #1492).
#
# `grep -c` prints a count on stdout for a readable file (0 on no match),
# but exits 1 whenever that count is 0, and prints nothing at all — exit 2,
# no "0" — for a missing/unreadable file. Both would break a caller under
# `set -e` and the second would make callers here miscount an empty log as
# unset (agy + codex review, PR #1544). Capturing into a local first and
# defaulting empty to "0" makes the function's own exit always 0 and its
# output always a number, matching what callers already assumed.
_count_bats_timeouts() {
    local n
    n=$(grep -cE '^not ok .*# timeout after [0-9]+s$' "$1" 2>/dev/null)
    printf '%s\n' "${n:-0}"
}

# Shared by run_bats()'s two "shell unit tests couldn't run" early-return
# sites: honor the SKIP_BATS=1 opt-out (mirrors SKIP_LOCAL_PYTEST=1 in
# git/hooks/pre-push), otherwise fail closed with a consistent message.
bats_fail_closed() {
    if [ "${SKIP_BATS:-0}" = "1" ]; then
        return 0
    fi
    print_error "Set SKIP_BATS=1 to explicitly bypass shell unit tests"
    return 1
}

# Progress ticker for run_bats()'s parallel phase (#2043). xargs workers are
# silent for minutes, so a waiting `git push` looks hung. Every
# BATS_PROGRESS_INTERVAL seconds it counts finished files (<idx>.status) in
# $outdir. TTY: one line rewritten in place (default 5s). Non-TTY (CI/log
# file): one plain line per tick (default 30s) so logs do not balloon.
# Caller runs it in the background and kills it once xargs returns.
_bats_progress_ticker() {
    local outdir="$1" total="$2" interval="${BATS_PROGRESS_INTERVAL:-}" tty=0 done_n
    [ -t 1 ] && tty=1
    if [ -z "$interval" ]; then
        if [ "$tty" = "1" ]; then interval=5; else interval=30; fi
    fi
    while sleep "$interval"; do
        done_n=$(find "$outdir" -maxdepth 1 -name '*.status' 2>/dev/null | wc -l)
        if [ "$tty" = "1" ]; then
            printf '\r  [%s/%s files]' "$done_n" "$total"
        else
            printf '  [%s/%s files]\n' "$done_n" "$total"
        fi
    done
}

# Feed "index\npath" pairs to `xargs -P $1`; -n 2 hands each (idx, path) to
# one _bats_run_file worker. Keying outputs by array index (not a
# path-derived name) gives the producer and run_bats' aggregation loop one
# shared, collision-free map. $2 = bats binary, $3 = outdir, rest = files.
_bats_feed_xargs() {
    local jobs="$1" bats_bin="$2" outdir="$3" i=0 f
    shift 3
    for f in "$@"; do
        printf '%s\n%s\n' "$i" "$f"
        i=$((i + 1))
    done | xargs -P "$jobs" -n 2 bash -c '_bats_run_file "$@"' _ "$bats_bin" "$outdir"
}

# ---------------------------------------------------------------------------
# Interrupt handling (#2054)
#
# bash runs a trap only after the current foreground command returns, so a
# runner blocked in `... | xargs -P` ignored TERM until every bats file was
# done — and Ctrl+C on `git push` left `uv run ./tests/test` alive for 2+
# hours. Long phases therefore run as background jobs in their own process
# group (_spawn_group) and the runner `wait`s on them: `wait` returns as soon
# as a trapped signal arrives, and the trap kills each group whole.
# ---------------------------------------------------------------------------

_TEST_GROUPS=""    # pgids of live phase groups, killed on interrupt/exit
_TEST_TMP_PATHS="" # scratch dirs removed on exit
_SPAWNED_PID=""

# Run "$@" in the background as the leader of a new process group (set -m),
# stdin from /dev/null so a background group can never stop on a TTY read.
# Nested calls (already inside a spawned group) stay in the outer group so a
# single group kill still reaches everything. Sets _SPAWNED_PID.
_spawn_group() {
    if [ -n "${_IN_TEST_GROUP:-}" ]; then
        "$@" </dev/null &
        _SPAWNED_PID=$!
        return 0
    fi
    set -m
    (
        _IN_TEST_GROUP=1
        "$@"
    ) </dev/null &
    _SPAWNED_PID=$!
    set +m
    _TEST_GROUPS="$_TEST_GROUPS $_SPAWNED_PID"
}

# Wait for a _spawn_group job and forget its group; returns its exit status.
_wait_group() {
    local rc=0 g rest=""
    wait "$1" || rc=$?
    for g in $_TEST_GROUPS; do
        [ "$g" = "$1" ] || rest="$rest $g"
    done
    _TEST_GROUPS="$rest"
    return "$rc"
}

# Run "$@" in its own group and wait for it: a foreground command whose
# interrupt is not deferred until it finishes.
_run_in_group() {
    _spawn_group "$@"
    _wait_group "$_SPAWNED_PID"
}

# TERM every live phase group, then KILL whatever is left after a 1s grace.
_kill_test_groups() {
    local g alive=0
    for g in $_TEST_GROUPS; do
        kill -TERM -- "-$g" 2>/dev/null && alive=1
    done
    if [ "$alive" = "1" ]; then
        sleep 1
        for g in $_TEST_GROUPS; do
            kill -KILL -- "-$g" 2>/dev/null
        done
    fi
    _TEST_GROUPS=""
}

_on_test_exit() {
    _kill_test_groups
    # shellcheck disable=SC2086 # space-separated mktemp paths
    [ -n "$_TEST_TMP_PATHS" ] && rm -rf $_TEST_TMP_PATHS
    rm -f "$(_test_run_registry_dir)/$$" 2>/dev/null
}

# $1 = exit code (128 + signal number). The EXIT trap does the cleanup.
_on_test_signal() {
    trap - INT TERM HUP
    [ -t 1 ] && printf '\r\033[K'
    print_warning "Interrupted — stopping all test workers"
    exit "$1"
}

_install_test_traps() {
    trap _on_test_exit EXIT
    trap '_on_test_signal 130' INT
    trap '_on_test_signal 143' TERM
    trap '_on_test_signal 129' HUP
}

# Run bats tests
#
# bats-core's own `--jobs` needs GNU parallel (or shenwei356/rush), which we
# do not want as a hard test dependency. Instead we run one bats process per
# .bats file bounded by CPU count via `xargs -P` — dependency-free and
# portable to bash 3.2 (macOS) + Linux. This is safe because every bats test
# isolates its own $HOME via mktemp (see tests/bats/test_helper.bash
# setup_isolated_home), so file-level parallelism has no shared mutable state.
# Serial mode (-s) keeps the single-process path for deterministic output.
run_bats() {
    local bats_bin="${SCRIPT_DIR}/bats/lib/bats-core/bin/bats"
    if [ ! -x "$bats_bin" ]; then
        print_warning "bats-core not found. Skipping shell unit tests."
        print_info "Run: git submodule update --init --recursive"
        bats_fail_closed
        return $?
    fi

    print_header "Running Bats Shell Unit Tests"

    # Per-test timeout (issue #1483), sanitized by _resolve_bats_timeout()
    # above. Exported so both branches below inherit it — including the
    # `bash -c` children xargs spawns, which get the environment but not
    # shell locals.
    BATS_TEST_TIMEOUT="$(_resolve_bats_timeout)"
    export BATS_TEST_TIMEOUT
    export -f _bats_run_file _resolve_bats_file_timeout _resolve_positive_int

    local bats_files=()
    while IFS= read -r f; do
        bats_files+=("$f")
    done < <(_discover_bats_files | _order_bats_by_duration)
    if [ ${#bats_files[@]} -eq 0 ]; then
        print_warning "No bats test files found"
        bats_fail_closed
        return $?
    fi

    # Serial: single bats invocation over all files (deterministic order).
    if [ "$SERIAL" = "1" ]; then
        _run_in_group "$bats_bin" "${bats_files[@]}"
        return $?
    fi

    # Parallel: one bats process per file, sized to this PC by
    # _test_job_budget and divided among concurrent ./tests/test runs
    # (#1413, #2054). BATS_JOBS overrides all of it.
    local jobs budget reason="(BATS_JOBS override)"
    if [ -z "${BATS_JOBS:-}" ]; then
        budget="$(_test_job_budget "$_BATS_JOBS_FACTOR" "$(_concurrent_test_run_count)")"
        jobs="${budget%% *}"
        reason="${budget#* }"
    else
        jobs="$(_resolve_bats_jobs)"
    fi
    local outdir
    outdir="$(mktemp -d)"
    # Removed by _on_test_exit if the run is interrupted (#2054).
    _TEST_TMP_PATHS="$_TEST_TMP_PATHS $outdir"
    print_info "Parallel: ${#bats_files[@]} files, ${jobs} jobs ${reason} — BATS_JOBS=N to override, -s for serial"

    local i f ticker_pid workers_pid
    _spawn_group _bats_progress_ticker "$outdir" "${#bats_files[@]}"
    ticker_pid=$_SPAWNED_PID
    _spawn_group _bats_feed_xargs "$jobs" "$bats_bin" "$outdir" "${bats_files[@]}"
    workers_pid=$_SPAWNED_PID
    _wait_group "$workers_pid"
    kill -TERM -- "-$ticker_pid" 2>/dev/null || kill "$ticker_pid" 2>/dev/null
    _wait_group "$ticker_pid" 2>/dev/null
    [ -t 1 ] && printf '\r\033[K'

    # Aggregate: count tests, print per-file failures with their full log.
    # Iterate the same indices the producer used, so outputs line up exactly.
    local rc=0 total_tests=0 failed_files=0 timeout_tests=0
    local status_val log_file n
    for i in "${!bats_files[@]}"; do
        f="${bats_files[$i]}"
        log_file="$outdir/$i.log"
        status_val=$(cat "$outdir/$i.status" 2>/dev/null || echo 1)
        if [ -f "$log_file" ]; then
            # grep -c always prints a count (0 on no match), so no fallback needed.
            n=$(grep -cE '^(ok|not ok)' "$log_file" 2>/dev/null)
            total_tests=$((total_tests + n))
            n=$(_count_bats_timeouts "$log_file")
            timeout_tests=$((timeout_tests + n))
        fi
        if [ "$status_val" != "0" ]; then
            failed_files=$((failed_files + 1))
            rc=1
            if [ "$status_val" = "124" ]; then
                print_error "FAILED (file timeout, BATS_FILE_TIMEOUT): ${f#"${SCRIPT_DIR}/"}"
            else
                print_error "FAILED: ${f#"${SCRIPT_DIR}/"}"
            fi
            [ -f "$log_file" ] && cat "$log_file"
        elif [ "$VERBOSE" = "1" ] && [ -f "$log_file" ]; then
            cat "$log_file"
        fi
    done

    _save_bats_durations "$outdir" "${bats_files[@]}"
    rm -rf "$outdir"

    if [ "$rc" -eq 0 ]; then
        print_success "bats: ${total_tests} tests in ${#bats_files[@]} files passed"
    else
        print_error "$(_bats_failure_summary "$failed_files" "${#bats_files[@]}" "$total_tests" "$timeout_tests")"
    fi
    return $rc
}

# Run golden rules
run_golden_rules() {
    local gr_script="${SCRIPT_DIR}/golden_rules/test_golden_rules.sh"
    if [ -f "$gr_script" ]; then
        print_header "Running Golden Rules"
        _run_in_group bash "$gr_script"
        return $?
    fi
    return 0
}

# Run pytest integration tests
run_pytest() {
    local verbose_flag=""

    if [ "$VERBOSE" = "1" ]; then
        verbose_flag="-v"
    fi

    print_header "Running Pytest Integration Tests"
    if [ "$SERIAL" = "1" ] || [ "$HAS_XDIST" = "0" ]; then
        # Serial: override addopts to remove xdist options
        _run_in_group python3 -m pytest tests/integration/ \
            $verbose_flag \
            --tb=short \
            -o addopts="-v --strict-markers" \
            -p no:xdist
    else
        # Size xdist's `-n auto` (from pyproject's addopts) the same way
        # run_bats sizes xargs -P: PYTEST_XDIST_AUTO_NUM_WORKERS is the
        # supported knob for what `auto` resolves to, so _test_job_budget
        # (pytest factor, PYTEST_JOBS_FACTOR) applies without touching
        # addopts. An override the caller already set wins untouched (#1413).
        local pytest_env=() budget
        if [ -z "${PYTEST_XDIST_AUTO_NUM_WORKERS:-}" ]; then
            budget="$(_test_job_budget "$_PYTEST_JOBS_FACTOR" "$(_concurrent_test_run_count)" "${PYTEST_JOBS_FACTOR:-}")"
            pytest_env=("PYTEST_XDIST_AUTO_NUM_WORKERS=${budget%% *}")
            print_info "Parallel: ${budget%% *} pytest workers ${budget#* } — PYTEST_XDIST_AUTO_NUM_WORKERS=N to override"
        fi
        _run_in_group env "${pytest_env[@]}" python3 -m pytest tests/integration/ $verbose_flag --tb=short
    fi
    return $?
}

# Run all tests
run_tests() {
    cd "$REPO_ROOT"
    export DOTFILES_TEST_MODE=1

    local exit_code=0

    # Serial (-s): fully sequential, as before.
    if [ "$SERIAL" = "1" ] || [ "${TEST_PHASES_SEQUENTIAL:-0}" = "1" ]; then
        run_bats || exit_code=1
        run_golden_rules || exit_code=1
        run_pytest || exit_code=1
        return $exit_code
    fi

    # Parallel (#2054): bats and pytest are independent, so pytest runs in
    # the background while bats runs here — wall time becomes max(bats,
    # pytest) instead of their sum. pytest's output is buffered and printed
    # after bats + golden rules so the logs never interleave; its group is
    # killed with everything else on Ctrl+C. TEST_PHASES_SEQUENTIAL=1 restores
    # the old order without forcing serial bats.
    local pytest_out pytest_pid
    pytest_out="$(mktemp)"
    _TEST_TMP_PATHS="$_TEST_TMP_PATHS $pytest_out"
    [ -t 1 ] && export PY_COLORS=1
    _spawn_group run_pytest >"$pytest_out" 2>&1
    pytest_pid=$_SPAWNED_PID

    run_bats || exit_code=1
    run_golden_rules || exit_code=1
    _wait_group "$pytest_pid" || exit_code=1
    cat "$pytest_out"
    rm -f "$pytest_out"

    return $exit_code
}

# Main
main() {
    local VERBOSE=0
    local SERIAL=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
        -a | --all)
            shift
            ;;
        -v | --verbose)
            VERBOSE=1
            shift
            ;;
        -s | --serial)
            SERIAL=1
            shift
            ;;
        -h | --help)
            show_help
            return 0
            ;;
        *)
            print_error "Unknown option: $1"
            echo "Use -h or --help for usage information"
            return 1
            ;;
        esac
    done

    # Announce this run so concurrent ./tests/test invocations on this host
    # can detect each other and split the CPU pool (#1413). After arg parsing
    # so -h/--help never registers. The traps are the single cleanup path for
    # every exit — normal, early return, or signal: the registry entry, the
    # scratch dirs and every worker group (#2054). No phase installs traps of
    # its own anymore, so nothing clobbers them (the PR #1416 caveat).
    _register_test_run
    _install_test_traps

    # Check requirements
    if ! check_requirements; then
        return 1
    fi

    # Run tests
    if run_tests; then
        print_success "All tests passed!"
        return 0
    else
        print_error "Some tests failed"
        return 1
    fi
}

# Run main function and exit with its return code.
# Guarded so this file can be `source`d (e.g. by tests) without executing
# main() — only a direct invocation (./tests/test) runs it.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
    exit_code=$?
    exit $exit_code
fi

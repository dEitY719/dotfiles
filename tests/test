#!/bin/bash
#
# Test Suite Runner for Dotfiles Project
#
# Usage:
#   ./tests/test              # Run all tests (parallel by default)
#   ./tests/test -a|--all     # Run all tests (same as above)
#   ./tests/test -v|--verbose # Run with verbose output
#   ./tests/test -s|--serial  # Run tests sequentially (disable parallel)
#   ./tests/test -h|--help    # Show help
#
# Requirements:
#   - Python 3.10+
#   - pytest
#   - pytest-xdist (for parallel execution)
#   - pexpect
#
# Environment:
#   Sets DOTFILES_TEST_MODE=1 for test-aware tool behavior
#   Parallel execution uses all available CPU cores by default
#   Self-throttles: detects other concurrent ./tests/test runs on this host
#   and divides the job count among them
#   Caps every bats test at BATS_TEST_TIMEOUT seconds (default 300) so a hung
#   test fails the suite instead of stalling it forever
#

# Note: Do NOT use 'set -e' as it terminates the script when main() returns
# non-zero exit code. Instead, we handle errors explicitly in main() function.

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Helper functions
print_header() {
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}! $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

# Show help
show_help() {
    cat <<EOF
Test Suite Runner for Dotfiles Project

USAGE:
    ./tests/test [OPTIONS]

OPTIONS:
    -a, --all       Run all tests (default)
    -v, --verbose   Run with verbose output
    -s, --serial    Run tests sequentially (disable parallel execution)
    -h, --help      Show this help message

ENVIRONMENT VARIABLES:
    DOTFILES_TEST_MODE=1  Enable test mode (prevents side effects)
    SKIP_BATS=1           Explicit opt-out: allow the suite to pass even
                           when shell unit tests couldn't run (bats-core
                           missing, or zero .bats files found). Without
                           this, both conditions now fail the suite.
    BATS_TEST_TIMEOUT=N   Per-test timeout in seconds (default: 300). A test
                           exceeding it is killed and reported as
                           "# timeout after Ns" instead of hanging the run.

EXAMPLES:
    ./tests/test                  # Run all tests (parallel)
    ./tests/test --verbose        # Verbose output (parallel)
    ./tests/test --serial         # Sequential execution
    ./tests/test --verbose --serial # Verbose + sequential

PERFORMANCE:
    Default: bats + pytest both run parallel across all CPU cores (~4-5 min)
    Serial:  Sequential execution, single bats process (~15+ min)
    Tune:    BATS_JOBS=N overrides bats job count (default: nproc)
    Throttle: detects other concurrent ./tests/test runs on this host and
             divides the job count among them (BATS_JOBS /
             PYTEST_XDIST_AUTO_NUM_WORKERS overrides are never throttled)

REQUIREMENTS:
    - Python 3.10+
    - pytest
    - pytest-xdist (for parallel execution)
    - pexpect

For more information, see: docs/abc-review-CX.md, docs/test-results-P0.md, and tests/README.md

EOF
}

# Check requirements
check_requirements() {
    local missing=0

    # Check Python
    if ! command -v python3 >/dev/null 2>&1; then
        print_error "Python 3 not found"
        missing=1
    else
        local py_version=$(python3 --version 2>&1 | awk '{print $2}')
        print_info "Python $py_version"
    fi

    # Check pytest
    if ! python3 -m pytest --version >/dev/null 2>&1; then
        print_error "pytest not found. Install with: pip install pytest pexpect"
        missing=1
    else
        local pytest_version=$(python3 -m pytest --version 2>&1 | head -1)
        print_info "$pytest_version"
    fi

    # Check pytest-xdist (optional, for parallel execution)
    # Use import check instead of pip show — uv-managed venvs may not have pip
    HAS_XDIST=0
    local xdist_version
    xdist_version=$(python3 -c "import xdist; print(xdist.__version__)" 2>/dev/null)
    if [ $? -eq 0 ]; then
        print_info "pytest-xdist $xdist_version (parallel execution enabled)"
        HAS_XDIST=1
    else
        print_warning "pytest-xdist not found. Tests will run serially. Install with: uv sync --group dev"
    fi

    if [ $missing -eq 1 ]; then
        print_error "Missing required dependencies"
        return 1
    fi

    return 0
}


# ---------------------------------------------------------------------------
# Concurrency self-throttling (issue #1413)
#
# Every ./tests/test invocation used to claim all $(nproc) cores for itself
# (bats via `xargs -P`, pytest via xdist's `-n auto`). On a machine running
# several worktrees at once that oversubscribes the host — 3-4 concurrent
# runs pushed load average past 25 on 20 cores, and each run got a fraction
# of a core instead of a whole one. So each run now registers itself, counts
# the other live runs, and divides the job pool among them.
# ---------------------------------------------------------------------------

# Registry dir for tracking concurrently-running ./tests/test invocations.
# One empty file per live PID; liveness is re-checked at read time (kill -0)
# and stale entries are pruned as they're found (see
# _concurrent_test_run_count), so a file left by a crashed/killed run is
# harmless. Scoped per-UID: a fixed shared name under TMPDIR would let the
# first user's `mkdir -p` (typically mode 755 under a standard umask) block
# every other user on the same host from registering — each UID gets its own
# directory instead, so cross-user permission conflicts can't happen (agy
# review, PR #1416).
_test_run_registry_dir() {
    printf '%s\n' "${TMPDIR:-/tmp}/dotfiles-tests-test-registry-$(id -u)"
}

# Register this process ($$) in the registry. Best-effort: if the dir can't
# be created (e.g. read-only /tmp), silently no-op — throttling degrades to
# "no throttling", never to a hard failure.
_register_test_run() {
    local dir
    dir="$(_test_run_registry_dir)"
    mkdir -p "$dir" 2>/dev/null || return 0
    : >"$dir/$$" 2>/dev/null
    return 0
}

# Count OTHER currently-running ./tests/test invocations (excludes $$).
# A registry entry counts only if `kill -0 <pid>` succeeds; an entry that
# fails the check is actively removed (not just skipped) so the registry
# stays close to its true size instead of growing unbounded across repeated
# runs — this also shrinks the (nonzero but very unlikely) window for a
# stale entry's PID to later be reused by an unrelated live process and get
# miscounted as a peer (codex/agy review, PR #1416).
_concurrent_test_run_count() {
    local dir count=0 f pid
    dir="$(_test_run_registry_dir)"
    [ -d "$dir" ] || {
        printf '0\n'
        return 0
    }
    for f in "$dir"/*; do
        [ -e "$f" ] || continue
        pid="${f##*/}"
        [ "$pid" = "$$" ] && continue
        if kill -0 "$pid" 2>/dev/null; then
            count=$((count + 1))
        else
            rm -f "$f" 2>/dev/null
        fi
    done
    printf '%s\n' "$count"
}

# CPU count: nproc (Linux) → getconf (macOS/BSD) → 4. Shared by the bats and
# pytest throttling paths so the fallback chain lives in exactly one place.
_test_cpu_count() {
    nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4
}

# Divide a base job count among this run and its detected peers.
# effective = max(1, base / (concurrent_count + 1)). Never returns < 1 or
# a non-integer. Falls back to $base unchanged if $base isn't a positive
# integer (defensive — callers already validate, but this must not crash).
#
# $2 (optional) is a precomputed peer count from _concurrent_test_run_count;
# pass it when the caller already has one to avoid re-scanning the registry.
# Omit it (the common case, and what the bats tests exercise) to compute it
# here.
_effective_parallel_jobs() {
    local base="$1" count="${2:-}" effective
    case "$base" in
    '' | *[!0-9]*)
        printf '%s\n' "$base"
        return 0
        ;;
    esac
    [ -n "$count" ] || count=$(_concurrent_test_run_count)
    effective=$((base / (count + 1)))
    [ "$effective" -lt 1 ] && effective=1
    printf '%s\n' "$effective"
}

# Resolve run_bats()'s parallel job count.
#   BATS_JOBS set    → honored verbatim (never throttled), 4 if not a
#                      positive integer (guards a bogus override).
#   BATS_JOBS unset  → CPU count (nproc → getconf → 4), divided among this
#                      run and any concurrent ./tests/test runs.
#
# $1 (optional) is a precomputed peer count, forwarded to
# _effective_parallel_jobs to avoid a second registry scan (run_bats already
# has one to build its throttle_note). Omit it to compute internally.
_resolve_bats_jobs() {
    local others="${1:-}" jobs
    jobs="${BATS_JOBS:-$(_test_cpu_count)}"
    # Guard a non-positive-integer BATS_JOBS override (gemini review).
    case "$jobs" in
    '' | *[!0-9]*) jobs=4 ;;
    esac
    [ "$jobs" -lt 1 ] && jobs=1
    if [ -n "${BATS_JOBS:-}" ]; then
        printf '%s\n' "$jobs"
        return 0
    fi
    _effective_parallel_jobs "$jobs" "$others"
}

# Resolve run_bats()'s per-test timeout in seconds (issue #1483).
#   BATS_TEST_TIMEOUT set    → honored verbatim (a file's own setup_file()
#                              can also raise it further per-file).
#   BATS_TEST_TIMEOUT unset  → 300. The full suite is ~4-5 min, so a single
#                              test still running after 300s is pathological
#                              — better a bounded TAP failure than the
#                              multi-hour silent hang of #1483.
_resolve_bats_timeout() {
    printf '%s\n' "${BATS_TEST_TIMEOUT:-300}"
}

# Discover the .bats files run_bats() executes, ordered by @test count
# descending (Longest-Processing-Time scheduling) so the long-pole file starts
# first and the parallel makespan approaches its floor.
#
# lib/ is the vendored bats-core submodule (its own test suite). _fixtures/ is
# deliberately-broken input invoked directly by tests — notably
# bats/_fixtures/hang_timeout.bats, which hangs on purpose and would burn a
# full BATS_TEST_TIMEOUT on every real run if discovered here.
_discover_bats_files() {
    find "${SCRIPT_DIR}/bats" -type f -name '*.bats' \
        -not -path '*/lib/*' -not -path '*/_fixtures/*' \
        -exec sh -c 'printf "%s\t%s\n" "$(grep -c "^@test" "$1")" "$1"' _ {} \; \
        | sort -rn | cut -f2-
}

# Build run_bats()'s failure summary line. The ", N timed out" clause appears
# only when a test was actually killed by BATS_TEST_TIMEOUT, so a #1483-style
# hang is visibly distinct from an ordinary assertion failure (#1483 D-1).
_bats_failure_summary() {
    local failed_files="$1" total_files="$2" total_tests="$3" timeout_tests="$4"
    local suffix=""
    [ "$timeout_tests" -gt 0 ] 2>/dev/null && suffix=", ${timeout_tests} timed out"
    printf 'bats: %s of %s files failed (%s tests total%s)\n' \
        "$failed_files" "$total_files" "$total_tests" "$suffix"
}

# Shared by run_bats()'s two "shell unit tests couldn't run" early-return
# sites: honor the SKIP_BATS=1 opt-out (mirrors SKIP_LOCAL_PYTEST=1 in
# git/hooks/pre-push), otherwise fail closed with a consistent message.
bats_fail_closed() {
    if [ "${SKIP_BATS:-0}" = "1" ]; then
        return 0
    fi
    print_error "Set SKIP_BATS=1 to explicitly bypass shell unit tests"
    return 1
}

# Run bats tests
#
# bats-core's own `--jobs` needs GNU parallel (or shenwei356/rush), which we
# do not want as a hard test dependency. Instead we run one bats process per
# .bats file bounded by CPU count via `xargs -P` — dependency-free and
# portable to bash 3.2 (macOS) + Linux. This is safe because every bats test
# isolates its own $HOME via mktemp (see tests/bats/test_helper.bash
# setup_isolated_home), so file-level parallelism has no shared mutable state.
# Serial mode (-s) keeps the single-process path for deterministic output.
run_bats() {
    local bats_bin="${SCRIPT_DIR}/bats/lib/bats-core/bin/bats"
    if [ ! -x "$bats_bin" ]; then
        print_warning "bats-core not found. Skipping shell unit tests."
        print_info "Run: git submodule update --init --recursive"
        bats_fail_closed
        return $?
    fi

    print_header "Running Bats Shell Unit Tests"

    # Exported so both branches below inherit it — including the `bash -c`
    # children xargs spawns, which get the environment but not shell locals.
    export BATS_TEST_TIMEOUT
    BATS_TEST_TIMEOUT="$(_resolve_bats_timeout)"

    local bats_files=()
    while IFS= read -r f; do
        bats_files+=("$f")
    done < <(_discover_bats_files)
    if [ ${#bats_files[@]} -eq 0 ]; then
        print_warning "No bats test files found"
        bats_fail_closed
        return $?
    fi

    # Serial: single bats invocation over all files (deterministic order).
    if [ "$SERIAL" = "1" ]; then
        "$bats_bin" "${bats_files[@]}"
        return $?
    fi

    # Parallel: one bats process per file, bounded by CPU count.
    # CPU count: nproc (Linux) → getconf (macOS/BSD) → 4, then divided among
    # any concurrent ./tests/test runs (#1413). BATS_JOBS overrides both.
    local jobs others=0 throttle_note=""
    if [ -z "${BATS_JOBS:-}" ]; then
        others="$(_concurrent_test_run_count)"
        [ "$others" -gt 0 ] && throttle_note=" (throttled: ${others} other ./tests/test run(s) detected)"
    fi
    jobs="$(_resolve_bats_jobs "$others")"
    local outdir
    outdir="$(mktemp -d)"
    # Clean the temp dir on normal exit and on interrupt so an aborted run
    # never leaks it; the signal handler also exits so Ctrl+C stops the
    # runner instead of continuing on a deleted outdir (gemini review).
    trap 'rm -rf "$outdir"' EXIT
    trap 'rm -rf "$outdir"; trap - EXIT; exit 130' INT TERM HUP
    print_info "Parallel: ${#bats_files[@]} files across ${jobs} jobs (override with BATS_JOBS=N, or -s for serial)${throttle_note}"

    # Emit "index\npath" pairs; -n 2 hands each (idx, path) to one worker.
    # Keying outputs by array index (not a path-derived name) gives the
    # producer and the aggregation loop below one shared, collision-free map.
    local i=0 f
    for f in "${bats_files[@]}"; do
        printf '%s\n%s\n' "$i" "$f"
        i=$((i + 1))
    done \
        | xargs -P "$jobs" -n 2 bash -c '
            bats="$1"; out="$2"; idx="$3"; f="$4"
            if "$bats" "$f" >"$out/$idx.log" 2>&1; then
                printf "0" >"$out/$idx.status"
            else
                printf "1" >"$out/$idx.status"
            fi
          ' _ "$bats_bin" "$outdir"

    # Aggregate: count tests, print per-file failures with their full log.
    # Iterate the same indices the producer used, so outputs line up exactly.
    local rc=0 total_tests=0 failed_files=0 timeout_tests=0
    local status_val log_file n
    for i in "${!bats_files[@]}"; do
        f="${bats_files[$i]}"
        log_file="$outdir/$i.log"
        status_val=$(cat "$outdir/$i.status" 2>/dev/null || echo 1)
        if [ -f "$log_file" ]; then
            # grep -c always prints a count (0 on no match), so no fallback needed.
            n=$(grep -cE '^(ok|not ok)' "$log_file" 2>/dev/null)
            total_tests=$((total_tests + n))
            # bats marks a BATS_TEST_TIMEOUT kill as
            # `not ok N <name> # timeout after Ns`.
            n=$(grep -cF '# timeout after ' "$log_file" 2>/dev/null)
            timeout_tests=$((timeout_tests + n))
        fi
        if [ "$status_val" != "0" ]; then
            failed_files=$((failed_files + 1))
            rc=1
            print_error "FAILED: ${f#"${SCRIPT_DIR}/"}"
            [ -f "$log_file" ] && cat "$log_file"
        elif [ "$VERBOSE" = "1" ] && [ -f "$log_file" ]; then
            cat "$log_file"
        fi
    done

    rm -rf "$outdir"
    trap - EXIT INT TERM HUP

    if [ "$rc" -eq 0 ]; then
        print_success "bats: ${total_tests} tests in ${#bats_files[@]} files passed"
    else
        print_error "$(_bats_failure_summary "$failed_files" "${#bats_files[@]}" "$total_tests" "$timeout_tests")"
    fi
    return $rc
}

# Run golden rules
run_golden_rules() {
    local gr_script="${SCRIPT_DIR}/golden_rules/test_golden_rules.sh"
    if [ -f "$gr_script" ]; then
        print_header "Running Golden Rules"
        bash "$gr_script"
        return $?
    fi
    return 0
}

# Run pytest integration tests
run_pytest() {
    local verbose_flag=""

    if [ "$VERBOSE" = "1" ]; then
        verbose_flag="-v"
    fi

    print_header "Running Pytest Integration Tests"
    if [ "$SERIAL" = "1" ] || [ "$HAS_XDIST" = "0" ]; then
        # Serial: override addopts to remove xdist options
        python3 -m pytest tests/integration/ \
            $verbose_flag \
            --tb=short \
            -o addopts="-v --strict-markers" \
            -p no:xdist
    else
        # Throttle xdist's `-n auto` (from pyproject's addopts) the same way
        # run_bats throttles xargs -P: PYTEST_XDIST_AUTO_NUM_WORKERS is the
        # supported knob for what `auto` resolves to, so the CPU count can be
        # divided among concurrent ./tests/test runs without touching addopts.
        # An override the caller already set wins untouched (#1413).
        local pytest_env=()
        if [ -z "${PYTEST_XDIST_AUTO_NUM_WORKERS:-}" ]; then
            local base_jobs
            base_jobs="$(_test_cpu_count)"
            pytest_env=("PYTEST_XDIST_AUTO_NUM_WORKERS=$(_effective_parallel_jobs "$base_jobs")")
        fi
        env "${pytest_env[@]}" python3 -m pytest tests/integration/ $verbose_flag --tb=short
    fi
    return $?
}

# Run all tests
run_tests() {
    cd "$REPO_ROOT"
    export DOTFILES_TEST_MODE=1

    local exit_code=0

    run_bats || exit_code=1
    run_golden_rules || exit_code=1
    run_pytest || exit_code=1

    # Unconditional, not trap-based: run_bats() sets and then clears its own
    # EXIT trap around $outdir, which silently clobbers (and never restores)
    # whatever trap main() registered before calling into here — so on every
    # normal, complete run the registry entry was never actually being
    # removed (agy review, PR #1416). This line is what performs the real
    # cleanup; main()'s trap is a secondary net for the early-return paths
    # (e.g. check_requirements failure) that occur before run_bats ever runs.
    rm -f "$(_test_run_registry_dir)/$$" 2>/dev/null

    return $exit_code
}

# Main
main() {
    local VERBOSE=0
    local SERIAL=0

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
        -a | --all)
            shift
            ;;
        -v | --verbose)
            VERBOSE=1
            shift
            ;;
        -s | --serial)
            SERIAL=1
            shift
            ;;
        -h | --help)
            show_help
            return 0
            ;;
        *)
            print_error "Unknown option: $1"
            echo "Use -h or --help for usage information"
            return 1
            ;;
        esac
    done

    # Announce this run so concurrent ./tests/test invocations on this host
    # can detect each other and split the CPU pool (#1413). After arg parsing
    # so -h/--help never registers. This trap only covers an early return
    # before run_tests() (e.g. check_requirements failing below) — run_bats()
    # sets its own EXIT trap and clears it when done, which silently
    # supersedes this one for every run that reaches it. run_tests() performs
    # the actual cleanup unconditionally on its own return for that reason
    # (agy review, PR #1416); an interrupted run still self-heals via
    # _concurrent_test_run_count's kill -0 + prune-on-read.
    _register_test_run
    trap 'rm -f "$(_test_run_registry_dir)/$$" 2>/dev/null' EXIT

    # Check requirements
    if ! check_requirements; then
        return 1
    fi

    # Run tests
    if run_tests; then
        print_success "All tests passed!"
        return 0
    else
        print_error "Some tests failed"
        return 1
    fi
}

# Run main function and exit with its return code.
# Guarded so this file can be `source`d (e.g. by tests) without executing
# main() — only a direct invocation (./tests/test) runs it.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
    exit_code=$?
    exit $exit_code
fi

# npmrc.internal
# Internal company PC configuration (direct connection, requires proxy)
#
# PLACEHOLDER: tracked values are fakes (*.example.invalid). The real ones live
# in the gitignored npm/npmrc.internal.local, which shell-common/setup.sh
# prefers (seeded by scripts/internal-config-migrate.sh, #1968).
#
# Usage:
#   This file is symlinked to ~/.npmrc by shell-common/setup.sh
#   Choose this option when using company internal network
#
# Note: prefix uses ${HOME} for portability (npm expands env vars in .npmrc)

registry=http://registry.example.invalid/repository/proxy-npm-registry/
strict-ssl=false
cafile=/etc/ssl/certs/ca-certificates.crt
proxy=http://proxy.example.invalid:8080
https-proxy=http://proxy.example.invalid:8080
noproxy=localhost,127.0.0.1,.example.invalid
prefix=${HOME}/.npm-global

{
  "autoUpdatesChannel": "latest",
  "enabledPlugins": {
    "authoring@authoring-skills": true,
    "claudecode@claudecode-skills": true,
    "codex@openai-codex": true,
    "devenv@devenv-skills": true,
    "gh-flow@gh-flow-skills": true,
    "gh-issue@gh-issue-skills": true,
    "gh-pr@gh-pr-skills": true,
    "gh-resolve@gh-resolve-skills": true,
    "gh-setup@gh-setup-skills": true,
    "gh-verify@gh-verify-skills": true,
    "harness@harness-skills": true,
    "notes@notes-skills": true,
    "packaging@packaging-skills": true,
    "pkm@pkm-skills": true,
    "ralph-loop@claude-plugins-official": true,
    "session@session-skills": true,
    "spec-flow@spec-flow-skills": true,
    "superpowers@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "video@video-skills": true,
    "visuals@visuals-skills": true
  },
  "env": {
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "10000",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "${HOME}/dotfiles/claude/hooks/post-bash-dispatch.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${HOME}/dotfiles/claude/hooks/bash_wait_loop_guard.py",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/bash_stdin_repl_guard.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${HOME}/dotfiles/claude/hooks/session-start-plugin-path-normalize.sh",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/session-start-pc-context.sh",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/plugin-sync-session.sh",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/session-start-settings-drift.sh",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/session-start-statusline-project-override.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "f=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-agent-state.sh\"; [ -x \"$f\" ] && bash \"$f\" session; exit 0",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${HOME}/dotfiles/claude/hooks/gh_issue_flow_stop_guard.py",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/devx_autopilot_stop_guard.py",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/skill_completion_guard.py",
            "type": "command"
          },
          {
            "command": "${HOME}/dotfiles/claude/hooks/plugin-sync-session.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "${HOME}/dotfiles/claude/hooks/gh_issue_flow_stop_guard.py",
            "type": "command"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "${HOME}/dotfiles/claude/statusline-command.sh",
    "refreshInterval": 60,
    "type": "command"
  },
  "telemetry": {
    "enabled": false
  },
  "theme": "dark",
  "tui": "fullscreen"
}

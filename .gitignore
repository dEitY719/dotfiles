.idea
.venv
*egg-info
*.pyc

.python-version
uv.lock

.git-credentials
git/.git-credentials
**/.git-credentials

.temp/
# Local machine-specific configurations
*.local.sh
ssh/*.local
shell-common/config/pg_services.list
# AWS Bedrock host-specific override for ~/.aws/config (#677 F-6).
# *.local.sh already covers aws/aws.local.sh; aws-config.local has no .sh
# extension so it needs an explicit rule.
aws/aws-config.local
# Note: pip.conf is symlinked to ~/.config/pip/pip.conf (outside this repo, not version controlled)

# Build artifacts (generated during setup in some environments)
build/
__pycache__/
*.egg-info/

# agentmemory/iii-engine writes state_store.db + stream_store here when its
# daemon is started with this repo as cwd (relative path in the tool's
# global config, not project-specific — see iii-config.yaml upstream).
/data/

# Secrets — never track. Originals must live outside the repo
# (e.g., ~/.config/dotfiles-secrets/ or a password manager).
.env
.secrets/
.git-crypt/

# Claude Code settings.json is now the tracked SSOT (#584). Only timestamped
# backups produced by setup.sh symlink-replacement remain ignored.
claude/settings.json.backup.*
# settings.local.json carries PC-specific env (사내 ANTHROPIC_BASE_URL,
# ANTHROPIC_AUTH_TOKEN, 사번 헤더 등). Gitignored so secrets never reach
# GitHub. Internal-PC users hand-create ~/.claude/settings.local.json once;
# claude/setup.sh prints the exact heredoc on Internal mode (#584).
claude/settings.local.json
.claude/

# Claude Code plugin manifest — 사내 전용 분류는 별도 private nested repo로
# 관리한다 (docs/feature/superpowers-specs/2026-07-01-claude-plugin-manifest-design.md).
# public 레포는 이 경로의 존재 자체를 추적하지 않는다.
/claude/plugin/company/
# restore.sh --sync 화이트리스트 (PC별 로컬 수동 추가 마켓플레이스/플러그인 보호).
/claude/plugin/.local-marketplaces.json
# 이 PC 가 실제로 설치한 플러그인/마켓플레이스 오버레이 (#1685). tracked
# claude/plugin/{marketplaces,plugins}.json 은 upstream 이 소유하는 **등록 계약**만
# 담고, 머신 로컬 설치 상태는 여기에 쌓인다 — 두 성질을 한 파일에 겹쳐 담던 탓에
# fork/mirror 가 upstream 의 플러그인 등록 커밋을 받을 때마다 충돌했다.
# 소비자(restore.sh / reconcile.sh)는 tracked + local 의 union 을 읽는다.
/claude/plugin/marketplaces.local.json
/claude/plugin/plugins.local.json
# 이 PC 에서 계약 항목을 uninstall 했다는 묘비(tombstone). 훅은 계약 파일을
# 쓰지 않으므로, 이것이 없으면 restore.sh 가 계약을 보고 다시 설치해 버린다.
# 묘비는 스코프마다 따로다 (#1695 라운드2) — company/ 쪽은 `/claude/plugin/company/`
# 규칙이 이미 통째로 제외하므로 여기서는 공용 스코프만 적으면 된다.
/claude/plugin/removed.local.json

# VS Code settings (bidirectional sync system, PC-specific)
.vscode/settings.json
.vscode/base.json.backup.*

# AGENTS.md generator backups
**/AGENTS.md.backup.*

# Oh-My-Zsh plugin installations (managed by install scripts)
# Users run install-* commands which clone plugins to ~/.oh-my-zsh/custom/plugins/
# These should NOT be tracked in dotfiles repo (environment-specific)
~/.oh-my-zsh/
.oh-my-zsh/

# understand-anything: 큐레이션 config + 지식 그래프는 추적, 작업 스크래치만 무시 (#1118)
# 추적: config.json, .understandignore, knowledge-graph.json, meta.json
# 무시: 재생성 가능한 중간 산출물 + auto-update 스테일니스 베이스라인(autoUpdate=false 이므로 불필요)
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/fingerprints.json
.understand-anything/.trash-*/
.understand-anything/*.log
.understand-anything/diff-overlay.json

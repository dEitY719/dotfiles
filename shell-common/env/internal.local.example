#!/bin/sh
# internal.local.sh (template) — internal-PC identifiers (#1944)
#
# 사용 방법 (internal / external 모드 PC 만):
#   cp shell-common/env/internal.local.example shell-common/env/internal.local.sh
#   # 아래 placeholder 를 실제 값으로 바꾼다 (internal.local.sh 는 gitignored)
#
# 실제 값은 공개 repo 의 어떤 tracked 파일에도 적지 않는다.

# 사내 GHES 호스트명 (ghes_mirror, git_ssh_check, gh_host, hermes-skill-install 이 사용)
export DOTFILES_GHES_HOST="ghes.example.invalid"

# 개발 서버용 SSH 키 파일명 (check_ssh 가 사용, 미설정 시 id_rsa_dev)
export DOTFILES_SSH_KEY_NAME="id_rsa_example"

# Claude 사용량 API (claude/statusline-command.sh 의 비용 세그먼트, #1966).
# 요청 URL 은 "${DOTFILES_CLAUDE_USAGE_API_URL}?id=${DOTFILES_CLAUDE_USAGE_ID}".
# 둘 중 하나라도 비면 statusline 은 비용 세그먼트를 생략한다.
export DOTFILES_CLAUDE_USAGE_API_URL="https://usage.example.invalid/"
export DOTFILES_CLAUDE_USAGE_ID="EMP00000"

# AWS / Bedrock 사내 기대값 (aws/diagnose.sh, aws/install-otel-managed-settings.sh, #1966)
export DOTFILES_AWS_BEDROCK_URL="https://bedrock.example.invalid"
export DOTFILES_AWS_SSO_START_URL="https://sso.example.invalid/start"
export DOTFILES_AWS_SSO_ACCOUNT_ID="000000000000"
# no_proxy 에 반드시 들어가야 하는 사내 도메인 (diagnose 가 검사, 앞의 점 없이)
export DOTFILES_INTERNAL_DOMAIN="corp.example.invalid"
# 사내 프록시 CA 인증서 본문 앞부분 (diagnose 가 CA bundle 포함 여부를 grep).
# 추가 CA(선택, 미포함 시 WARN)는 공백 구분 목록.
export DOTFILES_PROXY_CA_FINGERPRINT="EXAMPLEPROXYCAFINGERPRINT"
export DOTFILES_EXTRA_CA_FINGERPRINTS=""
# OTel collector 호스트와 managed-settings 의 NO_PROXY 에 넣을 사내 도메인(콤마 구분)
export DOTFILES_OTEL_ENDPOINT_HOST="otel.example.invalid"
export DOTFILES_OTEL_NO_PROXY_DOMAINS=".corp.example.invalid"

# 사내 LLM gateway URL (setup.sh 가 opencode/opencode.json.internal 렌더링에 사용, #1967)
export DOTFILES_OPENCODE_BASE_URL="http://llm-gateway.example.invalid/v1"

# opencode 리뷰 모델 id (gh_pr_review.sh 의 --ai opencode lane, #2007).
# 미설정이면 opencode lane 은 경고 후 건너뛴다.
export DOTFILES_OPENCODE_REVIEW_MODEL="example-corp/example-model"

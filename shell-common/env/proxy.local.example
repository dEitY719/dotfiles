#!/bin/sh
# proxy.local.sh (template)
# 환경별 프록시 설정 예제 (회사 환경용)
#
# 사용 방법:
#   1. 이 파일을 proxy.local.sh로 복사
#      cp proxy.local.example proxy.local.sh
#   2. 아래 placeholder(*.example.invalid) 를 실제 값으로 교체
#   3. proxy.local.sh는 자동으로 .gitignore에 의해 제외됨
#
# 실제 프록시 주소 / no_proxy 목록은 공개 repo 의 tracked 파일에 적지 않는다
# (#1969). 실제 값은 각 PC 의 proxy.local.sh 에만 둔다 — 사내 가이드 문서 참조.

# 회사 프록시 설정
# NOTE: 끝에 trailing slash('/')를 붙이지 마세요 — gateway-cli verify가
#       정규화된(slash 없는) URL을 기대하며, 붙이면 [!] warn이 재발합니다.
#       사내 가이드 문서를 그대로 복사할 때 특히 주의 (#1358).
export http_proxy="http://proxy.example.invalid:8080"
export HTTP_PROXY="$http_proxy"
export https_proxy="http://proxy.example.invalid:8080"
export HTTPS_PROXY="$https_proxy"

# FYI. NO_PROXY 값 사이에 공백이 있으면 제대로 인식되지 않을 수 있으니, 콤마(,)로만 구분 추천
# 사내 IP 대역 / 사내 도메인 suffix 를 콤마로 이어서 적는다.
export no_proxy="localhost,127.0.0.1,.example.invalid"
export NO_PROXY="$no_proxy"

# ============================================================
# NOTE: proxy_help() 및 check-proxy 명령어는 proxy.sh에서
#       환경 구분 없이 모든 환경에서 사용 가능합니다.
#       이 파일은 환경별 프록시 설정 오버라이드만 포함합니다.
# ============================================================

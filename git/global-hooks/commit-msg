#!/usr/bin/env bash
# Global Git Commit-msg Wrapper (issue #1664)
#
# Installed by git/setup.sh as ~/.config/git/hooks/commit-msg and activated by
# 'git config --global core.hooksPath'.
#
# WHY THIS FILE EXISTS
#   core.hooksPath REPLACES .git/hooks for EVERY repository on this machine —
#   git does not merge the two and does not fall back. Without a wrapper here,
#   a project-level git/hooks/commit-msg is never invoked: it is dead code.
#
# WHAT IT DOES — DELEGATION ONLY
#   Unlike the pre-commit wrapper, this file carries NO checks of its own.
#   It forwards the hook to the project-level hook of the repository being
#   committed to (.githooks/ -> git/hooks/ -> .git/hooks/), passing through
#   arguments, stdin and the exit code unchanged. In a repository that ships
#   no commit-msg hook it is a silent no-op — repo-specific message rules
#   (conventional commits, closing-keyword policy) must never fire in
#   unrelated repositories. Shared forwarding logic: git/global-hooks/lib/delegate.sh.
#
# Hook protocol (git commit commit-msg):
#   $1 = path of the file holding the proposed commit message
#
# To bypass: git commit --no-verify
# To debug:  export GIT_HOOKS_DEBUG=1

set -u

HOOK_NAME="commit-msg"

# Resolve this wrapper's real location (it is installed as a symlink under
# ~/.config/git/hooks, so "$0"'s directory is not where lib/ lives).
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
# shellcheck source=./lib/delegate.sh
source "$(dirname "$SELF")/lib/delegate.sh"

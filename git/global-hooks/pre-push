#!/usr/bin/env bash
# Global Git Pre-push Wrapper (issue #1664)
#
# Installed by git/setup.sh as ~/.config/git/hooks/pre-push and activated by
# 'git config --global core.hooksPath'.
#
# WHY THIS FILE EXISTS
#   core.hooksPath REPLACES .git/hooks for EVERY repository on this machine —
#   git does not merge the two and does not fall back. Without a wrapper here,
#   a project-level git/hooks/pre-push is never invoked: it is dead code.
#
# WHAT IT DOES — DELEGATION ONLY
#   Unlike the pre-commit wrapper, this file carries NO checks of its own.
#   It forwards the hook to the project-level hook of the repository currently
#   being pushed from (.githooks/ -> git/hooks/ -> .git/hooks/), passing
#   through arguments, stdin and the exit code unchanged. In a repository that
#   ships no pre-push hook it is a silent no-op — repo-specific logic (this
#   dotfiles repo's `mise run test`, protected-branch block and leak guard)
#   must never fire in unrelated repositories. Shared forwarding logic:
#   git/global-hooks/lib/delegate.sh.
#
# Hook protocol (git push pre-push):
#   $1 = remote name, $2 = remote URL
#   stdin lines: "<local_ref> <local_sha> <remote_ref> <remote_sha>"
#   stdin is inherited by the delegate, never read here.
#
# To bypass: git push --no-verify
# To debug:  export GIT_HOOKS_DEBUG=1

set -u

HOOK_NAME="pre-push"

# Resolve this wrapper's real location (it is installed as a symlink under
# ~/.config/git/hooks, so "$0"'s directory is not where lib/ lives).
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
# shellcheck source=./lib/delegate.sh
source "$(dirname "$SELF")/lib/delegate.sh"

[user]
	email = deity719@naver.com
	name = dEitY719
[credential]
	helper = store
[core]
	editor = code --wait
	hooksPath = ~/.config/git/hooks
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[lfs]
	activitytimeout = 300
	locksverify = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[alias]
	sync = !\"${DOTFILES_ROOT:-$HOME/dotfiles}/git/scripts/git-sync.sh\"
[credential "https://github.com"]
	helper =
	useHttpPath = true
	helper = !${DOTFILES_ROOT:-$HOME/dotfiles}/git/scripts/gh-credential-helper.sh
[credential "https://gist.github.com"]
	helper =
	useHttpPath = true
	helper = !${DOTFILES_ROOT:-$HOME/dotfiles}/git/scripts/gh-credential-helper.sh
# Machine-local overrides (gitignored, #2006): the internal GHES credential
# section lives here on internal PCs, seeded by
# scripts/internal-ssh-git-migrate.sh. A missing file is ignored by git.
[include]
	path = ~/.gitconfig.internal.local

#!/usr/bin/env bash
# git/hooks/pre-commit
# Project-level pre-commit hook for dotfiles repo.
#
# Runner responsibilities:
# - Load every git/hooks/checks/*_check.sh and register its check (#2143)
# - Collect staged files and dispatch each check by its CHECK_SCOPE
# - Aggregate results and exit appropriately
#
# Adding a check = adding one checks/<name>_check.sh file; this runner never
# changes. Contract: git/doc/CHECK_REGISTRY.md.

# ═══════════════════════════════════════════════════════════════════════════
# Configuration and setup
# ═══════════════════════════════════════════════════════════════════════════

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# The registry needs associative arrays (bash 4+); fail loudly instead of
# half-running on an old bash (e.g. macOS /bin/bash 3.2).
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    echo -e "${RED}✗ BLOCKING: git/hooks/pre-commit needs bash 4+ (found ${BASH_VERSION:-unknown})${NC}"
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ] || [ ! -d "$REPO_ROOT" ]; then
    exit 0
fi

CHECKS_DIR="${REPO_ROOT}/git/hooks/checks"
HOOK_CONFIG_PATH="${REPO_ROOT}/git/config/hook-config.sh"
if [ -f "$HOOK_CONFIG_PATH" ]; then
    # shellcheck source=/dev/null
    . "$HOOK_CONFIG_PATH"
else
    echo -e "${RED}✗ BLOCKING: Hook config not found: $HOOK_CONFIG_PATH${NC}"
    exit 1
fi

if [ ! -d "$CHECKS_DIR" ]; then
    echo -e "${RED}✗ BLOCKING: Checks directory not found: $CHECKS_DIR${NC}"
    exit 1
fi

debug() {
    [ "${GIT_HOOKS_DEBUG:-}" = "1" ] && echo "[pre-commit] $*" >&2
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# Load + register checks
# ═══════════════════════════════════════════════════════════════════════════

declare -A CHECK_SCOPE_OF=() CHECK_SEVERITY_OF=() CHECK_TITLE_OF=() CHECK_LABEL_OF=()
declare -A CHECK_LINES_OF=() CHECK_HINT_OF=() CHECK_COUNT_LINES_OF=() CHECK_OUT=() CHECK_COUNT=()
CHECK_NAMES=()

load_module_or_exit() {
    # shellcheck source=/dev/null
    if ! . "$1"; then
        echo -e "${RED}✗ BLOCKING: Failed to load hook module: $1${NC}"
        exit 1
    fi
}

invalid_check() {
    echo -e "${RED}✗ BLOCKING: Invalid check module $1: $2 (contract: git/doc/CHECK_REGISTRY.md)${NC}"
    exit 1
}

# Libraries, not checks: shared helpers + the protected-branch pre-flight.
load_module_or_exit "${CHECKS_DIR}/shared.sh"
load_module_or_exit "${CHECKS_DIR}/main_branch_guard.sh"

# Explicit C-locale sort: glob order follows LC_COLLATE and must not vary by machine.
mapfile -t CHECK_FILES < <(printf '%s\n' "$CHECKS_DIR"/*_check.sh | LC_ALL=C sort)
for check_file in "${CHECK_FILES[@]}"; do
    [ -f "$check_file" ] || continue
    unset CHECK_NAME CHECK_SCOPE CHECK_SEVERITY CHECK_TITLE CHECK_LABEL CHECK_REPORT_LINES CHECK_HINT CHECK_COUNT_LINES
    unset -f check_run
    load_module_or_exit "$check_file"
    # A *_check.sh without CHECK_NAME is a library for another hook
    # (closing_keyword_check.sh serves commit-msg), not a pre-commit check.
    # One that defines check_run but forgot CHECK_NAME is a broken check.
    if [ -z "${CHECK_NAME:-}" ]; then
        declare -F check_run >/dev/null && invalid_check "$check_file" "check_run is defined but CHECK_NAME is not"
        debug "loaded without registering (no CHECK_NAME): ${check_file##*/}"
        continue
    fi
    [[ "$CHECK_NAME" =~ ^[a-z][a-z0-9_]*$ ]] || invalid_check "$check_file" "CHECK_NAME '$CHECK_NAME' is not [a-z][a-z0-9_]*"
    [ -z "${CHECK_SCOPE_OF[$CHECK_NAME]:-}" ] || invalid_check "$check_file" "duplicate CHECK_NAME '$CHECK_NAME'"
    case "${CHECK_SCOPE:-}" in per-file | per-shell-file | global) ;; *) invalid_check "$check_file" "CHECK_SCOPE '${CHECK_SCOPE:-}'" ;; esac
    case "${CHECK_SEVERITY:-}" in blocking | warning) ;; *) invalid_check "$check_file" "CHECK_SEVERITY '${CHECK_SEVERITY:-}'" ;; esac
    [ -n "${CHECK_TITLE:-}" ] || invalid_check "$check_file" "CHECK_TITLE is empty"
    declare -F check_run >/dev/null || invalid_check "$check_file" "check_run is not defined"

    # check_run is one shared name per file; keep each under its own name.
    eval "check_run__${CHECK_NAME}() $(declare -f check_run | tail -n +2)"
    CHECK_NAMES+=("$CHECK_NAME")
    CHECK_SCOPE_OF[$CHECK_NAME]="$CHECK_SCOPE"
    CHECK_SEVERITY_OF[$CHECK_NAME]="$CHECK_SEVERITY"
    CHECK_TITLE_OF[$CHECK_NAME]="$CHECK_TITLE"
    CHECK_LABEL_OF[$CHECK_NAME]="${CHECK_LABEL:-}"
    CHECK_LINES_OF[$CHECK_NAME]="${CHECK_REPORT_LINES:-}"
    CHECK_HINT_OF[$CHECK_NAME]="${CHECK_HINT:-}"
    CHECK_COUNT_LINES_OF[$CHECK_NAME]="${CHECK_COUNT_LINES:-}"
    CHECK_COUNT[$CHECK_NAME]=0
    debug "registered check: $CHECK_NAME ($CHECK_SCOPE, $CHECK_SEVERITY)"
done
unset -f check_run

# Report order: CHECK_ORDER (hook-config.sh) first, then the rest in load
# (file name) order.
ORDERED_CHECKS=()
for name in "${CHECK_ORDER[@]}"; do
    [ -n "${CHECK_SCOPE_OF[$name]:-}" ] && ORDERED_CHECKS+=("$name")
done
for name in "${CHECK_NAMES[@]}"; do
    case " ${ORDERED_CHECKS[*]} " in *" $name "*) ;; *) ORDERED_CHECKS+=("$name") ;; esac
done

# Leak guard active (#2002): every check below prints staged paths (the
# ShellCheck report even prints code), so run this hook once more with its whole output
# through one filter that replaces each LEAK_PATTERNS_ERE match. Inactive:
# leak_guard_active fails on the env checks and nothing changes.
if [ -z "${LEAK_REDACT_PIPED:-}" ] && leak_guard_active; then
    LEAK_REDACT_PIPED=1 "$0" "$@" 2>&1 | leak_redact
    exit "${PIPESTATUS[0]}"
fi

# ═══════════════════════════════════════════════════════════════════════════
# Protected-branch guard (fail fast, before any file scanning)
# ═══════════════════════════════════════════════════════════════════════════

if ! check_main_branch_guard; then
    echo ""
    echo -e "${RED}✗ BLOCKING: direct commit on protected branch '${MAIN_BRANCH_GUARD_CURRENT:-<unknown>}'${NC}"
    echo ""
    echo -e "${YELLOW}  Create a feature branch first, for example:${NC}"
    echo -e "${YELLOW}    git switch -c feat/your-change${NC}"
    echo ""
    echo -e "${YELLOW}  Escape hatch (use sparingly, e.g. release/hotfix commits):${NC}"
    echo -e "${YELLOW}    ALLOW_MAIN_COMMIT=1 git commit ...${NC}"
    echo ""
    exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# Get staged files (git diff --cached)
# ═══════════════════════════════════════════════════════════════════════════

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || echo "")
# Includes deletions (D) — ACMR alone hides a removed tools/custom/*.sh from
# the command-docs staleness check (codex review, PR #1741). Gate the
# early-exit on this superset: a commit that is *only* a deletion leaves
# STAGED_FILES empty while this stays non-empty, and must still reach that
# check instead of short-circuiting here.
STAGED_FILES_WITH_DELETIONS=$(git diff --cached --name-only --diff-filter=ACDMR 2>/dev/null || echo "")
if [ -z "$STAGED_FILES_WITH_DELETIONS" ]; then
    exit 0
fi

# ═══════════════════════════════════════════════════════════════════════════
# Run checks
# ═══════════════════════════════════════════════════════════════════════════

# One scratch dir for every check's report file and temp copies.
CHECK_TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX") || exit 1
trap 'rm -rf "$CHECK_TMPDIR"' EXIT
for name in "${CHECK_NAMES[@]}"; do
    CHECK_OUT[$name]="$CHECK_TMPDIR/$name.out"
    : >"${CHECK_OUT[$name]}"
done

run_check() { # <name> <file-or-empty>
    if ! "check_run__$1" "$REPO_ROOT" "$CHECK_TMPDIR" "$2" "${CHECK_OUT[$1]}"; then
        CHECK_COUNT[$1]=$((CHECK_COUNT[$1] + 1))
    fi
}

while IFS= read -r file; do
    [ -n "$file" ] || continue
    shell_lib=0
    is_shell_lib_file "$REPO_ROOT" "$file" && shell_lib=1
    for name in "${CHECK_NAMES[@]}"; do
        case "${CHECK_SCOPE_OF[$name]}" in
        per-file) run_check "$name" "$file" ;;
        per-shell-file) [ "$shell_lib" -eq 1 ] && run_check "$name" "$file" ;;
        esac
    done
done <<<"$STAGED_FILES"

for name in "${CHECK_NAMES[@]}"; do
    [ "${CHECK_SCOPE_OF[$name]}" = "global" ] || continue
    run_check "$name" ""
    # CHECK_COUNT_LINES=1: each report line is one finding (leak_pattern).
    if [ "${CHECK_COUNT_LINES_OF[$name]}" = "1" ] && [ "${CHECK_COUNT[$name]}" -gt 0 ]; then
        CHECK_COUNT[$name]=$(grep -c '^' "${CHECK_OUT[$name]}")
    fi
done

# ═══════════════════════════════════════════════════════════════════════════
# Reporting and exit logic
# ═══════════════════════════════════════════════════════════════════════════

report_check() { # <name>
    local name="$1" out="${CHECK_OUT[$1]}" count="${CHECK_COUNT[$1]}"
    local lines="${CHECK_LINES_OF[$1]}" color="$YELLOW" label="${CHECK_LABEL_OF[$1]:-WARNING}"
    [ "$count" -gt 0 ] || return 0
    if [ "${CHECK_SEVERITY_OF[$name]}" = "blocking" ]; then
        color="$RED"
        label="BLOCKING"
    else
        [ -s "$out" ] || return 0
    fi
    echo -e "${color}[$label] ${CHECK_TITLE_OF[$name]} ($count):${NC}"
    if [ ! -s "$out" ]; then
        # A failing blocking check must never be counted without a reason shown.
        echo "  (check '$name' failed without writing a report; rerun with GIT_HOOKS_DEBUG=1)"
    elif [ -n "$lines" ]; then
        head -n "$lines" "$out" | sed 's/^/  /'
        [ "$(wc -l <"$out")" -gt "$lines" ] && echo "  ... and more"
    else
        sed 's/^/  /' "$out"
    fi
    [ -n "${CHECK_HINT_OF[$name]}" ] && printf '%s\n' "${CHECK_HINT_OF[$name]}" | sed 's/^/  /'
    echo ""
}

blocking_violations=0
has_warnings=0
for name in "${CHECK_NAMES[@]}"; do
    [ "${CHECK_COUNT[$name]}" -gt 0 ] || continue
    if [ "${CHECK_SEVERITY_OF[$name]}" = "blocking" ]; then
        blocking_violations=$((blocking_violations + CHECK_COUNT[$name]))
    elif [ -s "${CHECK_OUT[$name]}" ]; then
        has_warnings=1
    fi
done

echo ""
echo -e "${BLUE}Pre-commit validation (staged files only)${NC}"
echo ""

if [ "$blocking_violations" -gt 0 ]; then
    echo -e "${RED}✗ Found $blocking_violations BLOCKING violation(s)${NC}"
    echo ""
    for name in "${ORDERED_CHECKS[@]}"; do
        [ "${CHECK_SEVERITY_OF[$name]}" = "blocking" ] && report_check "$name"
    done
fi

for name in "${ORDERED_CHECKS[@]}"; do
    [ "${CHECK_SEVERITY_OF[$name]}" = "warning" ] && report_check "$name"
done

[ "$blocking_violations" -gt 0 ] && exit 1

if [ "$has_warnings" -eq 0 ]; then
    echo -e "${GREEN}✓ All checks passed!${NC}"
else
    echo -e "${GREEN}✓ All critical checks passed (with warnings above)${NC}"
fi
echo ""
exit 0
